# config.env.example — 개인 환경 설정 예시
#
#   cp config.env.example config.env   →  값을 내 환경에 맞게 고친다
#
# config.env 는 .gitignore 에 들어 있어 커밋되지 않는다 (경로·계정 같은 개인 값이 공유 저장소에 섞이지 않게).
# 읽는 곳: scripts/track.py · steps/1-issue-hunting/scripts/hunt.py (루트의 config.env 를 직접 파싱)
#          steps/4-build-and-test/scripts/*.sh (source)
#          → 이 파일 값이 셸 환경변수보다 우선한다 (파일이 진실). 여기 없는 키만 환경변수/기본값
# 문서의 $CHROMIUM_SRC 같은 표기를 셸에서도 그대로 쓰려면 ~/.zshrc 등에:
#   export OSSCA=~/ossca            # 이 저장소를 클론한 위치
#   source "$OSSCA/config.env"

# Chromium 체크아웃의 src 디렉토리
export CHROMIUM_SRC="$HOME/chromium/src"

# 빌드 출력 디렉토리 (CHROMIUM_SRC 기준 상대 경로). release component build 기준 — SETUP.md 4번
export CHROMIUM_OUT="out/Default"

# OSSCA 기여 기록 저장소(contributions)의 로컬 클론 — origin = 내 fork, upstream = OSSCA-chromium
export CONTRIBUTIONS_DIR="$HOME/contributions"

# GitHub 계정 (contributions fork 의 소유자). 7단계 PR 생성 URL 등에 쓰임
export GITHUB_USER="your-github-id"

# OSSCA 기여 기록 upstream 저장소 (프로그램이 바뀌지 않는 한 그대로)
export OSSCA_REPO="OSSCA-chromium/contributions"

# 멘토 이메일 — $CONTRIBUTIONS_DIR/CONTRIBUTING.md 에서 확인. CL 에 리뷰어(docs/ 변경) 또는 CC(그 외)로 추가
export MENTOR_EMAIL="mentor@example.com"

# 테스트 바이너리 공통 플래그. 헤드리스 리눅스(SSH) 서버면 --ozone-platform=headless 가 필수 —
# 없으면 TestWebContents 를 만드는 테스트가 전부 CRASHED 된다. 화면이 있는 데스크톱이면 비워도 된다
export TEST_FLAGS="--ozone-platform=headless"
